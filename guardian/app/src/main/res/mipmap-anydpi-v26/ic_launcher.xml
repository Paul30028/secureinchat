<!--
  Adaptive icon. minSdk 26 means anydpi-v26 is sufficient; no PNG fallbacks needed.
  Background is the solid brand green (#23483E) from the favicon. The foreground is the stroked
  white shield from ic_launcher_foreground.xml. The monochrome layer reuses the same drawable: the
  system tints by alpha, and a stroked vector has full alpha along the stroke, so it renders
  correctly under the "themed icons" option on Android 13+ without a second asset.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
