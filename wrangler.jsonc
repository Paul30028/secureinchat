{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secureinchat",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-25",
  "ratelimits": [
    { "name": "SITECHECK_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/tools/api/*"]
  }
}
