--- a/guardian/core/src/main/kotlin/org/secureinchat/guardian/dns/DotClient.kt
+++ b/guardian/core/src/main/kotlin/org/secureinchat/guardian/dns/DotClient.kt
@@ -28,8 +28,14 @@ class DotClient(
     private val addresses: List<InetSocketAddress>,
     private val openSocket: () -> Socket,
     private val wrapTls: (Socket, String) -> Socket,
-    private val connectTimeoutMs: Int = 4000,
-    private val readTimeoutMs: Int = 4000
+    private val connectTimeoutMs: Int = 3000,
+    private val readTimeoutMs: Int = 4000,
+    /**
+     * Total time one query may spend opening a connection across all addresses. Without it, a provider
+     * whose packets are dropped costs (addresses × connect timeout) per lookup, and the system resolver
+     * gives up long before Guardian answers (seen in the emulator: a lookup hung for over 30 s).
+     */
+    private val connectBudgetMs: Long = 5000
 ) {
     private val lock = Any()
     private var socket: Socket? = null
@@ -46,6 +52,10 @@ class DotClient(
         val id = ((payload[0].toInt() and 0xFF) shl 8) or (payload[1].toInt() and 0xFF)
         synchronized(lock) {
             repeat(2) { attempt ->
+                // The retry is for a reused connection the resolver closed in the meantime. When this
+                // attempt had to open a fresh connection and still failed, a second sweep only doubles
+                // the wait.
+                val reused = socket != null
                 try {
                     if (socket == null) connect()
                     val out = output!!
@@ -65,10 +75,10 @@ class DotClient(
                     throw IOException("no answer with the query id")
                 } catch (_: IOException) {
                     closeLocked()
-                    if (attempt == 1) return null
+                    if (attempt == 1 || !reused) return null
                 } catch (_: RuntimeException) {
                     closeLocked()
-                    if (attempt == 1) return null
+                    if (attempt == 1 || !reused) return null
                 }
             }
             return null
@@ -79,11 +89,14 @@ class DotClient(
 
     private fun connect() {
         var last: Exception? = null
+        val deadline = System.currentTimeMillis() + connectBudgetMs
         for (addr in addresses) {
+            val remaining = deadline - System.currentTimeMillis()
+            if (remaining <= 0) break
             var raw: Socket? = null
             try {
                 raw = openSocket()
-                raw.connect(addr, connectTimeoutMs)
+                raw.connect(addr, minOf(connectTimeoutMs.toLong(), remaining).toInt().coerceAtLeast(1))
                 raw.soTimeout = readTimeoutMs
                 val tls = wrapTls(raw, hostname)
                 tls.soTimeout = readTimeoutMs
diff --git a/guardian/core/src/test/kotlin/org/secureinchat/guardian/dns/DotClientTest.kt b/guardian/core/src/test/kotlin/org/secureinchat/guardian/dns/DotClientTest.kt
index afd8fbf..35df0ff 100644
--- a/guardian/core/src/test/kotlin/org/secureinchat/guardian/dns/DotClientTest.kt
+++ b/guardian/core/src/test/kotlin/org/secureinchat/guardian/dns/DotClientTest.kt
@@ -130,5 +130,37 @@ fun main() {
         c.close()
     }
 
+    dtt("blackholed provider: one lookup gives up within the connect budget, no second sweep") {
+        // Every address drops packets: connect waits out its timeout. 4 addresses x 1 s with a 2.5 s
+        // budget must stop after the budget, not try all four twice (that was ~32 s with the defaults).
+        val attempts = AtomicInteger()
+        class BlackholeSocket : Socket() {
+            override fun connect(endpoint: java.net.SocketAddress?, timeout: Int) {
+                attempts.incrementAndGet()
+                Thread.sleep(timeout.toLong())
+                throw java.net.SocketTimeoutException("blackholed")
+            }
+        }
+        val addrs = (1..4).map { InetSocketAddress(InetAddress.getLoopbackAddress(), 1000 + it) }
+        val c = DotClient("dns.example", addrs, { BlackholeSocket() }, { s, _ -> s },
+            connectTimeoutMs = 1000, readTimeoutMs = 500, connectBudgetMs = 2500)
+        val t0 = System.currentTimeMillis()
+        deq2(c.query(query(7)), null)
+        val took = System.currentTimeMillis() - t0
+        check(took < 3500) { "took $took ms" }
+        check(attempts.get() <= 3) { "${attempts.get()} connect attempts" }
+    }
+
+    dtt("a reused connection that the resolver closed is retried once on a fresh one") {
+        // First connection answers once and then closes; the next query must reconnect and succeed.
+        val r = FakeResolver { q, out, n -> out.send(answerFor(q)); n != 1 }
+        val c = client(r.addr)
+        check(c.query(query(8)) != null)
+        Thread.sleep(100)
+        check(c.query(query(9)) != null) { "no retry on a fresh connection" }
+        deq2(c.connectionsOpened, 2)
+        c.close()
+    }
+
     println("DotClientTest: $dn passed")
 }
